[
  {
    "name": "submit_emergency_report",
    "description": "Create a new unverified emergency report from a message describing an emergency, hazard, affected people, or a request for emergency help.",
    "parameters": {
      "type": "object",
      "properties": {
        "needs": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "medical_help",
              "medicine",
              "rescue",
              "evacuation",
              "food",
              "water",
              "shelter",
              "transport",
              "communication",
              "supplies",
              "other"
            ]
          },
          "uniqueItems": true
        },
        "need_details": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "hazards": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "flood",
              "fire",
              "structural_collapse",
              "landslide",
              "severe_weather",
              "chemical_hazard",
              "unsafe_road",
              "violence",
              "power_outage",
              "other"
            ]
          },
          "uniqueItems": true
        },
        "location_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "affected_people_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "urgency_cue": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_quotes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "needs",
        "need_details",
        "hazards",
        "location_text",
        "affected_people_count",
        "urgency_cue",
        "evidence_quotes"
      ],
      "additionalProperties": false
    }
  },
